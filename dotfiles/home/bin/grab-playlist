#!/bin/bash

while read playlist path; do

echo "will grab $playlist and put it at $path"

	if [ -z "$path" ]; then
		mkdir -p "${path}"
	fi

	caffeinate -i -s yt-dlp --cookies-from-browser chrome --ignore-errors --continue --extract-audio --playlist-start 1 --audio-format m4a --no-keep-video --output "$path/%(title)s.%(ext)s" -- "${playlist}"

done
